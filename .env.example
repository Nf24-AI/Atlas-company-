# Copy to .env (git-ignored) and fill locally. Never commit .env. Keys stay on the server.
# Without keys every AI employee runs in clearly labelled DEMO mode (scripted, $0).
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# Employee model configuration (verify IDs in provider docs before changing; see docs/COSTS.md).
MANAGER_PROVIDER=groq
MANAGER_MODEL=openai/gpt-oss-120b
DIRECTOR_PROVIDER=deepseek
DIRECTOR_MODEL=deepseek-v4-pro
DEVELOPER_PROVIDER=deepseek
DEVELOPER_MODEL=deepseek-flash
QA_PROVIDER=groq
QA_MODEL=openai/gpt-oss-120b

# Spending cap for the whole company per calendar month (USD). Per-employee daily caps are in the CEO workspace.
ATLAS_MONTHLY_BUDGET_USD=5

# Optional: real pull requests on a DEDICATED sandbox GitHub repo (fine-grained token scoped to that repo only:
# Contents read/write + Pull requests read/write). Leave empty to use local review requests.
SANDBOX_GITHUB_REPO=
SANDBOX_GITHUB_TOKEN=

# Server stays on localhost. Do not change HOST unless following docs/DEPLOYMENT.md.
HOST=127.0.0.1
PORT=3099
# ATLAS_DATA_DIR=./data
