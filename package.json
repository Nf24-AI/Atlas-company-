{
  "name": "atlas-company-os",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Arabic-first 3D browser-based AI company simulator (local backend, static public demo)",
  "scripts": {
    "start": "node server.js",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "build:demo": "node scripts/build-demo.mjs",
    "demo": "node scripts/build-demo.mjs && node scripts/serve-static.mjs dist 4173",
    "lint": "node scripts/lint.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1"
  }
}
